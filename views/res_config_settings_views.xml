<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.board.interval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Dashboards" id="board_interval_settings">
                    <setting
                        id="board_interval_date_field_setting"
                        string="Dashboard Date Field"
                        help="Technical name of the Date or Datetime field used by the dashboard date selector. Blocks whose model does not have this field are left unfiltered."
                    >
                        <field
                            name="board_interval_date_field"
                            placeholder="date_order"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
